# ============================================================
# PostgreSQL 17 Slim — 二阶段构建
# Stage 1: 从官方镜像删除冗余 (locale/perl/doc 等)
# Stage 2: 展平到 scratch，消除多层开销
# ============================================================

FROM postgres:17 AS builder

RUN rm -rf \
    /usr/share/doc \
    /usr/share/man \
    /usr/share/locale \
    /usr/share/i18n \
    /usr/share/perl \
    /usr/share/perl5 \
    /usr/lib/locale \
    /var/cache/apt \
    /var/log

FROM scratch

COPY --from=builder / /

VOLUME /var/lib/postgresql/data
EXPOSE 5432
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["postgres"]
