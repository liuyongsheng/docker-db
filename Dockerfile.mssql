# ============================================================
# MSSQL 2017 Slim — 二阶段构建
# Stage 1: 提取 / 清理原始镜像
# Stage 2: 展平到 scratch，消除多层开销
# ============================================================

FROM softwareplant/mssql:clean-2017-mcr-jira-9-arm64 AS builder

RUN rm -rf \
    /usr/share/doc \
    /usr/share/man \
    /usr/share/locale \
    /var/cache/apt \
    /var/log

FROM scratch

COPY --from=builder / /

VOLUME /var/opt/mssql
EXPOSE 1433
ENTRYPOINT ["/docker-entrypoint.sh"]
